[Unit]
Description=Video File Manager Flask App
After=network.target

[Service]
# Adjust these paths/user to match your install location and pi username
User=pi
WorkingDirectory=/home/pi/AV-Monitor
ExecStart=/home/pi/AV-Monitor/launcher.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
