# Settings for the capture buffer. Edit, then run: sudo systemctl restart mjpeg-review
# (setup.sh installs this file as the service's environment.)

# Capture card. List what it offers with: v4l2-ctl -d /dev/video1 --list-formats-ext
VIDEO_DEVICE=/dev/video1
VIDEO_SIZE=720x576
VIDEO_FPS=25

# Rolling buffer: whichever limit is reached first trims the oldest frames.
BUFFER_SECONDS=60
MAX_BUFFER_MB=150

# Web server
PORT=8443

# Signal loss. If no frames arrive for STALL_SECONDS, ffmpeg is restarted.
# The page shows "No signal" after SIGNAL_TIMEOUT seconds without frames.
STALL_SECONDS=5
SIGNAL_TIMEOUT=2
